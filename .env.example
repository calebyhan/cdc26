# Optional extractors are selected per document in Documents & review.
# Keep all settings server-side; never use NEXT_PUBLIC_ prefixes.
# Next.js loads .env locally. Legacy Streamlit requires exported process variables.

# Codex (ChatGPT sign-in): run `codex login` on the server machine first.
# No API key is needed. Online requests use your ChatGPT/Codex usage allowance.
# Intended for the local fictional demo; do not copy CLI authentication files here.
# Empty means use the installed CLI's default model (no --model argument).
# Set an identifier only after confirming support with your ChatGPT CLI account.
NMD_CODEX_MODEL=
# Integer seconds, from 10 through 300.
NMD_CODEX_TIMEOUT_SECONDS=120

# Separate OpenAI API option; API billing and provider retention policies apply.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Google Gemini (extraction, case analysis, and the in-app guide).
# Put the real key in .env.local (ignored by Git), never in this file.
GEMINI_API_KEY=
# Optional comma-separated model chain; a busy or quota-exhausted model hands off
# to the next. Default: gemini-flash-latest,gemini-3.8-flash,gemini-3.7-flash,
# gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_MODELS=

# Optional interpreter override; default is .venv/bin/python.
# NMD_PYTHON=/absolute/path/to/python
